//6.3 CertMonitorWorker.kt
// – WorkManager‑Task, prüft Anomalien und ruft Erneuerung auf

package com.deinunternehmen.cert_manager_automonimport android.content.Context

import android.util.Log
import androidx.work.CoroutineWorker
import androidx.work.WorkerParametersprivate const val WORKER_TAG = "CertMonitorWorker"class CertMonitorWorker(
    appContext: Context,
    params: WorkerParameters
) : CoroutineWorker(appContext, params) {override suspend fun doWork(): Result {
    Log.d(WORKER_TAG, "Periodic check started")
    val detector = AnomalyDetector(appContext)
    return if (detector.isSuspicious()) {
        Log.i(WORKER_TAG, "Anomaly detected → renewing certificate")
        CertRenewalManager(appContext).renewCertificate()
        Result.success()
    } else {
        Log.d(WORKER_TAG, "No anomaly – nothing to do")
        Result.success()
    }}}



//6.4 AnomalyDetector.kt
// – einfache Heuristik (kann erweitert werden)

package com.deinunternehmen.cert_manager_automonimport android.content.Context

import android.content.SharedPreferences
import android.util.Logprivate const val PREFS_NAME = "cert_manager_prefs"
private const val KEY_FAIL_COUNT = "fail_cnt"
private const val KEY_LAST_TS = "last_ts"class AnomalyDetector(private val ctx: Context) {private val prefs: SharedPreferences =
    ctx.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
/** * Beispiel‑Heuristik: >5 fehlgeschlagene Logins innerhalb von 10 Minuten.
 * Du kannst weitere Checks (Netzwerk‑GeoIP, File‑Hash, Root‑Erkennung, …) hinzufügen. 
*/fun isSuspicious(): Boolean {
    val now = System.currentTimeMillis()
    val lastTs = prefs.getLong(KEY_LAST_TS, 0L)
    // Reset‑Logik: wenn das Zeitfenster abgelaufen ist, Zähler zurücksetzen
    if (now - lastTs > 10 * 60_000) {
        prefs.edit().putInt(KEY_FAIL_COUNT, 0).apply()
        return false
    }    
    val fails = prefs.getInt(KEY_FAIL_COUNT, 0)
    Log.d("AnomalyDetector", "Current fail count: $fails")
    return fails >= 5}
/** Aufruf aus deiner Login‑Logik,
 um einen Fehlschlag zu zählen
 */fun registerFailedLogin() {
    val now = System.currentTimeMillis()
    prefs.edit()
        .putLong(KEY_LAST_TS, now)
        .putInt(KEY_FAIL_COUNT, prefs.getInt(KEY_FAIL_COUNT, 0) + 1)
        .apply()}}



