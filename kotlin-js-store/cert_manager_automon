// – Hilfsobjekt zum Erzeugen des CSR

package com.deinunternehmen.cert_manager_automonimport org.bouncycastle.asn1.x500.X500Name
import org.bouncycastle.pkcs.PKCS10CertificationRequestBuilder
import org.bouncycastle.pkcs.jcajce.JcaPKCS10CertificationRequestBuilder
import org.bouncycastle.operator.jcajce.JcaContentSignerBuilder
import org.bouncycastle.util.io.pem.PemObject
import org.bouncycastle.util.io.pem.PemWriter
import java.io.StringWriter
import java.security.interfaces.RSAPrivateKey
import java.security.interfaces.RSAPublicKeyobject CryptoHelper {

/** * Erstellt einen PEM‑kodierten PKCS#10‑CSR.
 * * @param pubKey  RSA‑Public‑Key
 * @param privKey RSA‑Private‑Key
 (zum Signieren)
 * @param subjectDn DN‑String, 
z. B. "CN=cert_manager_automon" */


fun createCsr(
    pubKey: RSAPublicKey,
    privKey: RSAPrivateKey,
    subjectDn: String): String {
    val subject = X500Name(subjectDn)
    val builder: PKCS10CertificationRequestBuilder = 
       JcaPKCS10CertificationRequestBuilder(subject, pubKey)
    val signer = JcaContentSignerBuilder("SHA256withRSA").build(privKey)
    val csr = builder.build(signer)
    // PEM‑Kodierung
    val sw = StringWriter()
    PemWriter(sw).use { pw ->
        pw.writeObject(PemObject("CERTIFICATE REQUEST", csr.encoded))
    }
    return sw.toString()}}


